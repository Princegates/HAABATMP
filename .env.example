# ---------------------------------------------------------------------------
# HAAB Training Platform: environment variables
# Copy to .env for local work. In production these are set on the host (Render),
# never committed. Keys for outside services (email, malware scanning, and later SMS
# and payments) are NOT set here: a super administrator enters them in the app under
# System setting > API & Integrations, where they are stored encrypted.
# ---------------------------------------------------------------------------

# ---- API (apps/api) --------------------------------------------------------
NODE_ENV=development
PORT=4000
# Runtime connection. With Supabase use the pooled (transaction mode) connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atmp
# Used only for migrations. With Supabase use the DIRECT connection string.
# DATABASE_URL_DIRECT=
DATABASE_SSL=false

# 'dev' signs its own tokens and is refused in production. 'supabase' verifies Supabase Auth tokens.
AUTH_MODE=dev
DEV_PASSWORD=ChangeMe!2026
DEV_JWT_SECRET=dev-only-secret-change-me-dev-only-secret

# Where the browser app lives (CORS, and the link printed in certificate QR codes).
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ---- Needed in production (AUTH_MODE=supabase) ------------------------------
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=                # the legacy anon key OR the newer publishable key (sb_publishable_...)
# SUPABASE_SERVICE_ROLE_KEY=        # the legacy service_role key OR the newer secret key (sb_secret_...). Server only. Never expose to the browser.
# SUPABASE_JWT_SECRET=              # only for projects that still use the legacy shared secret; otherwise JWKS is used
# Master key that encrypts stored credentials and ID numbers. 32 random bytes, base64:  openssl rand -base64 32
# Losing it makes stored credentials and ID numbers unreadable. Keep a sealed copy.
# DATA_ENCRYPTION_KEY=

# ---- Files -----------------------------------------------------------------
STORAGE_DRIVER=local            # local | supabase (production must use supabase)
STORAGE_DIR=./storage
# SUPABASE_STORAGE_BUCKET=atmp-documents   # create it as a PRIVATE bucket
# MAX_UPLOAD_MB=25
# The HAAB logo printed on certificates, invoices and receipts defaults to apps/web/public/brand/haab-logo.png.
# LOGO_PATH=

# Shared by the API and the web app (set the SAME value on both, 24+ random characters). Lets the web app tell the
# API each visitor's real address, so rate limits and the audit log are per person. Required in production.
# PROXY_SHARED_SECRET=

# Test runs only. Ignored (and refused) in production.
# THROTTLE_DISABLED=true

# ---- Web (apps/web) --------------------------------------------------------
# Server-side only. The browser never talks to the API directly.
API_URL=http://localhost:4000
